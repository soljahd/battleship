{
  "name": "battleship",
  "version": "1.0.0",
  "description": "Battleship. The RS School nodejs couse project",
  "engines": {
    "node": ">=24.10.0",
    "npm": ">=10.9.2"
  },
  "license": "ISC",
  "author": "soljahd",
  "type": "module",
  "scripts": {
    "start": "tsx ./src/index.ts",
    "start:dev": "tsx --watch ./src/index.ts",
    "start:prod": "tsc && node ./dist/index.js",
    "test": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier ./src --check",
    "format:fix": "prettier ./src --write"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "ws": "^8.18.3"
  }
}
